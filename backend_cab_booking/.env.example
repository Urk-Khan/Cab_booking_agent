# ---- Telnyx ----
# Only needed once you connect a real phone number (skip entirely for local text/audio testing).
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_ACCOUNT_SID=your-telnyx-account-sid-here
# A Telnyx number enabled on a messaging profile, used as the "from" for booking-confirmation
# SMS (send_confirmation in tools.py). E.164 format, e.g. +14155551234.
TELNYX_SMS_FROM_NUMBER=
# TeXML Application ID and the phone number it answers — used by start_agent.py's
# auto-launcher (updates the Telnyx webhook, prints which number is live).
TELNYX_APP_ID=your-texml-application-id-here
TELNYX_PHONE_NUMBER=your-telnyx-phone-number-here

# ---- STT + TTS: Cartesia (both stages use the same key) ----
STT_PROVIDER=cartesia
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your-cartesia-api-key-here
CARTESIA_VOICE_ID=your-cartesia-voice-id-here

# ---- LLM: pick one (all require an API key) ----
LLM_PROVIDER=openai              # openai | anthropic
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Google Places API (New): pickup/drop-off location lookup ----
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ---- Supabase: bookings/customers/vehicles/drivers database ----
# Project Settings -> API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — keep it server-side only, never
# ship it to a browser/mobile client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


LOG_LEVEL=INFO
