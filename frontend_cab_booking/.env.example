# Same Supabase project the voice agent (bot.py / booking_db.py) already writes to.
# Server-side only — never prefix these with NEXT_PUBLIC_, since the service-role
# key must not reach the browser.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# If these are left unset, the dashboard runs on built-in demo data so you can
# preview the UI immediately.

# Shown in the top bar ("Voice agent listening on ..."). Same number as the voice agent's
# own TELNYX_PHONE_NUMBER.
AGENT_PHONE_NUMBER=your-agent-phone-number-here
